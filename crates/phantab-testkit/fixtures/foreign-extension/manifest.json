{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.0.0",
  "default_locale": "en",
  "description": "Test stand-in for a password manager's inline autofill menu (Bitwarden 2026.10).",
  "content_scripts": [{"matches": ["http://127.0.0.1/*"], "js": ["menu.js"]}],
  "web_accessible_resources": [{"matches": ["<all_urls>"], "resources": ["overlay/menu.html"], "use_dynamic_url": true}]
}
