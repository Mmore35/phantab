{
  "manifest_version": 3,
  "name": "phantab bridge",
  "version": "0.4.0",
  "description": "Lets the local phantab service drive pages in this Chrome profile, without Chrome's remote-debugging approval prompt.",
  "homepage_url": "https://github.com/Mmore35/phantab",
  "minimum_chrome_version": "125",
  "key": "",
  "permissions": ["debugger", "tabs", "nativeMessaging", "alarms", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {"default_title": "phantab bridge: no agent working"},
  "background": {"service_worker": "background.js", "type": "module"}
}
